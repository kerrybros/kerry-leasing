{
  "name": "@kerry-leasing/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm prisma:generate && tsc && cp -r src/generated dist/",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prisma:repair:pull": "prisma db pull --schema prisma/repair/schema.prisma",
    "prisma:repair:generate": "prisma generate --schema prisma/repair/schema.prisma",
    "prisma:app:migrate": "prisma migrate dev --schema prisma/app/schema.prisma",
    "prisma:app:migrate:deploy": "prisma migrate deploy --schema prisma/app/schema.prisma",
    "prisma:app:generate": "prisma generate --schema prisma/app/schema.prisma",
    "prisma:app:studio": "prisma studio --schema prisma/app/schema.prisma",
    "prisma:generate": "pnpm prisma:repair:generate && pnpm prisma:app:generate",
    "sync-motive": "pnpm prisma:generate && tsx src/cron/sync-motive-daily.ts",
    "sync-samsara": "pnpm prisma:generate && tsx src/cron/sync-samsara-daily.ts",
    "backdate": "tsx src/telematics/motive/backdate.ts",
    "backdate-samsara": "tsx src/telematics/samsara/backdate.ts",
    "backdate-motive-by-month": "tsx src/scripts/backdate-motive-by-month.ts",
    "telematics:credentials:normalize": "tsx src/scripts/normalize-telematics-credentials.ts",
    "wipe-motive-org": "tsx src/scripts/wipe-motive-org.ts",
    "update-org-id": "tsx src/scripts/update-org-id.mjs",
    "deploy:build": "pnpm prisma:generate && pnpm build"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@kerry-leasing/shared": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^5.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^20.10.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "prisma": "^5.7.0",
    "typescript": "^5.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "vitest": "^1.0.0"
  }
}
