// This is your Prisma schema file for the APP database (portal-owned data)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/app-client"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

// Maps Clerk organization IDs to customer IDs in the repair database
model CustomerOrgMap {
  id          String   @id @default(cuid())
  clerkOrgId  String   @unique @map("clerk_org_id")
  customerId  String   @map("customer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([clerkOrgId])
  @@map("customer_org_maps")
}

// Repair customer configuration for this portal org (KL org)
// This avoids mixing Clerk org IDs with "customer_id" naming.
// Scoping for repair reads is done via:
// - REPAIR_SHOP_ORG_ID (fixed repair shop)
// - customer_name (this model)
// - contract_start_date (this model)
model RepairCustomerConfig {
  id                String   @id @default(cuid())
  klOrgId            String   @unique @map("kl_org_id")
  customerName       String   @map("customer_name")
  contractStartDate  DateTime @map("contract_start_date")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([klOrgId])
  @@map("repair_customer_configs")
}

// Organization Settings
// Configures feature flags and display preferences per organization
model OrganizationSettings {
  id                          String   @id @default(cuid())
  clerkOrgId                  String   @unique @map("clerk_org_id")
  tracksDrivers               Boolean  @default(true) @map("tracks_drivers") // Whether org uses driver tracking
  serviceRequestUrl           String?  @map("service_request_url")           // FullBay or external service request link
  contractTermYears           Int?     @map("contract_term_years")           // 1-5 years
  telematicsDashboardUrl      String?  @map("telematics_dashboard_url")      // Provider web UI URL for reference
  telematicsDashboardUsername String?  @map("telematics_dashboard_username") // Provider web UI username
  telematicsDashboardPassword String?  @map("telematics_dashboard_password") // Provider web UI password (plaintext reference)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@index([clerkOrgId])
  @@map("organization_settings")
}

// Telematics Provider Configuration
// Each org can have ONE provider configured (SAMSARA or MOTIVE)
model TelematicsProviderAccount {
  id              String                     @id @default(cuid())
  clerkOrgId      String                     @unique @map("clerk_org_id")
  provider        TelematicsProvider
  credentialsJson Json                       @map("credentials_json") // Encrypted in future
  status          TelematicsProviderStatus   @default(ACTIVE)
  lastSyncAt      DateTime?                  @map("last_sync_at")
  lastError       String?                    @map("last_error")
  lastBackdateReport Json?                   @map("last_backdate_report")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  @@index([clerkOrgId])
  @@index([status])
  @@map("telematics_provider_accounts")
}

// SAMSARA Idling Events (source table: one row per event, no aggregation)
// Link to fuel-energy by assetId = vehicle.id and date when combining in API
model SamsaraIdlingEvent {
  id                     String   @id @default(cuid())
  clerkOrgId             String   @map("clerk_org_id")
  assetId                String   @map("asset_id")   // same as vehicle.id in fuel-energy
  startTime              String   @map("start_time") // ISO 8601
  durationMilliseconds   Float?   @map("duration_milliseconds")
  fuelConsumedMilliliters Float?  @map("fuel_consumed_milliliters")
  eventDate              String   @map("event_date") // YYYY-MM-DD for querying
  rawResponse            Json?    @map("raw_response")
  createdAt              DateTime @default(now()) @map("created_at")

  @@unique([clerkOrgId, assetId, startTime])
  @@index([clerkOrgId])
  @@index([clerkOrgId, eventDate])
  @@index([assetId])
  @@map("samsara_idling_events")
}

// MOTIVE Raw Data (source of truth)
// Stores complete Motive API responses with typed schema
// MotiveRawData removed — table dropped in 20260320_drop_motive_raw_data migration.
// All Motive data is stored in MotiveVehicleUtilization, MotiveDriverUtilization,
// MotiveDrivingPeriod, MotiveIdleEvent, and MotiveGeofence.

// Vehicle Mapping: Links provider vehicle IDs to VINs
// Used when provider doesn't return VIN or returns incorrect VIN
model TelematicsVehicleMap {
  id                  String             @id @default(cuid())
  clerkOrgId          String             @map("clerk_org_id")
  vin                 String
  provider            TelematicsProvider
  providerVehicleId   String             @map("provider_vehicle_id")
  providerVehicleName String?            @map("provider_vehicle_name")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([clerkOrgId, provider, providerVehicleId])
  @@unique([clerkOrgId, vin])
  @@index([clerkOrgId])
  @@index([vin])
  @@index([providerVehicleId])
  @@map("telematics_vehicle_maps")
}

// MOTIVE Driving Periods (individual driving trips)
// Source: GET /v1/driving_periods
// Stores each driving period with origin/destination and distance
// NOTE: Data may be updated retroactively - requires lookback verification
model MotiveDrivingPeriod {
  id                          String    @id @default(cuid())
  clerkOrgId                  String    @map("clerk_org_id")
  motivePeriodId              BigInt    @map("motive_period_id") // Motive's period ID
  
  // Driver info (null when period has no driver assigned)
  driverId                    Int?      @map("driver_id")
  driverFirstName             String?   @map("driver_first_name")
  driverLastName              String?   @map("driver_last_name")
  driverUsername              String?   @map("driver_username")
  driverEmail                 String?   @map("driver_email")
  
  // Vehicle info
  vehicleId                   Int       @map("vehicle_id")
  vehicleNumber               String?   @map("vehicle_number")
  vin                         String?
  
  // Period timing
  startTime                   String    @map("start_time") // ISO 8601
  endTime                     String?   @map("end_time")   // ISO 8601 (null if in_progress)
  date                        String    // YYYY-MM-DD (derived from start_time)
  duration                    Float?    // seconds
  
  // Period metadata
  status                      String?   // "in_progress", "complete", "interrupted"
  type                        String?   // "driving", "PC" (personal conveyance), "YM" (yard move)
  annotationStatus            Int?      @map("annotation_status") // 0=not annotated, 1=annotated, 2=pending
  notes                       String?
  source                      Int?      // Data source indicator
  
  // Distance/odometer
  startKilometers             Float?    @map("start_kilometers")
  endKilometers               Float?    @map("end_kilometers")
  distance                    String?   // Human-readable distance with units
  
  // Origin location
  origin                      String?
  originLat                   Float?    @map("origin_lat")
  originLon                   Float?    @map("origin_lon")
  
  // Destination location
  destination                 String?
  destinationLat              Float?    @map("destination_lat")
  destinationLon              Float?    @map("destination_lon")
  
  // Electric vehicle metrics (if applicable)
  startHvbStateOfCharge       Float?    @map("start_hvb_state_of_charge")
  endHvbStateOfCharge         Float?    @map("end_hvb_state_of_charge")
  startHvbLifetimeEnergyOutput Float?   @map("start_hvb_lifetime_energy_output")
  endHvbLifetimeEnergyOutput  Float?    @map("end_hvb_lifetime_energy_output")
  
  // Data verification tracking
  lastVerifiedAt              DateTime? @map("last_verified_at")
  dataVersion                 Int       @default(1) @map("data_version")
  
  // Full API response for reference
  rawResponse                 Json      @map("raw_response")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@unique([clerkOrgId, motivePeriodId])
  @@index([clerkOrgId])
  @@index([motivePeriodId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([vin])
  @@index([date])
  @@index([status])
  @@index([clerkOrgId, date])
  @@index([startTime])
  @@index([lastVerifiedAt])
  @@map("motive_driving_periods")
}

// MOTIVE Idle Events (individual idle occurrences)
// Source: GET /v1/idle_events
// Stores each idle event with location and fuel data
// NOTE: Data may be added retroactively - requires lookback verification
model MotiveIdleEvent {
  id                String    @id @default(cuid())
  clerkOrgId        String    @map("clerk_org_id")
  motiveEventId     BigInt    @map("motive_event_id") // Motive's event ID
  
  // Driver info (optional — some events have no driver assigned)
  driverId          Int?      @map("driver_id")
  driverFirstName   String?   @map("driver_first_name")
  driverLastName    String?   @map("driver_last_name")
  driverUsername    String?   @map("driver_username")
  driverEmail       String?   @map("driver_email")
  
  // Vehicle info
  vehicleId         Int       @map("vehicle_id")
  vehicleNumber     String?   @map("vehicle_number")
  vin               String?
  
  // Event timing
  startTime         String    @map("start_time") // ISO 8601
  endTime           String    @map("end_time")   // ISO 8601
  date              String    // YYYY-MM-DD (derived from start_time)
  
  // Fuel data (Motive imperial: gallons with X-Metric-Units: false)
  vehFuelStart      Float?    @map("veh_fuel_start") // gallons at event start
  vehFuelEnd        Float?    @map("veh_fuel_end")   // gallons at event end
  idleFuel          Float?    @map("idle_fuel")      // computed: veh_fuel_start - veh_fuel_end (gallons)
  
  // Location data
  lat               Float?
  lon               Float?
  city              String?
  state             String?
  location          String?   // Combined location string
  
  // Road geometry data
  rgBrg             Float?    @map("rg_brg") // Road bearing
  rgKm              Float?    @map("rg_km")  // Road distance
  rgMatch           Boolean?  @map("rg_match")
  
  // Event metadata
  endType           String?   @map("end_type") // "vehicle_moving", "engine_stop", etc.
  eldDeviceId       Int?      @map("eld_device_id")
  eldIdentifier     String?   @map("eld_identifier")
  
  // Data verification tracking
  lastVerifiedAt    DateTime? @map("last_verified_at") // When data was last checked against API
  dataVersion       Int       @default(1) @map("data_version") // Increment when updated from API
  
  // Full API response for reference
  rawResponse       Json      @map("raw_response")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([clerkOrgId, motiveEventId])
  @@index([clerkOrgId])
  @@index([motiveEventId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([vin])
  @@index([date])
  @@index([clerkOrgId, date])
  @@index([startTime])
  @@index([lastVerifiedAt]) // For finding records that need re-verification
  @@map("motive_idle_events")
}

// MOTIVE Driver Utilization (per day, per driver)
// Source: GET /v2/driver_utilization (queried with single-day ranges)
// Stores daily driver utilization metrics
// NOTE: Data may be updated retroactively - requires lookback verification
model MotiveDriverUtilization {
  id                String    @id @default(cuid())
  clerkOrgId        String    @map("clerk_org_id")
  driverId          Int?      @map("driver_id") // Motive driver ID (null when API returns rollup with no driver)
  driverFirstName   String?   @map("driver_first_name")
  driverLastName    String?   @map("driver_last_name")
  driverUsername    String?   @map("driver_username")
  driverEmail       String?   @map("driver_email")
  date              String    // YYYY-MM-DD (single day)
  
  // Daily utilization metrics
  utilization       Float?    // Percentage
  idleTime          Int?      @map("idle_time") // seconds
  drivingTime       Int?      @map("driving_time") // seconds
  idleFuel          Float?    @map("idle_fuel") // gallons
  drivingFuel       Float?    @map("driving_fuel") // gallons
  
  // Data verification tracking
  lastVerifiedAt    DateTime? @map("last_verified_at")
  dataVersion       Int       @default(1) @map("data_version")
  
  // Full API response for reference
  rawResponse       Json      @map("raw_response")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([clerkOrgId, driverId, date])
  @@index([clerkOrgId])
  @@index([driverId])
  @@index([date])
  @@index([clerkOrgId, date])
  @@index([lastVerifiedAt])
  @@map("motive_driver_utilization")
}

// MOTIVE Vehicle Utilization (per day, per vehicle)
// Source: GET /v1/vehicle_utilization
// Stores daily utilization metrics for each vehicle
// NOTE: Data may be updated retroactively - requires lookback verification
model MotiveVehicleUtilization {
  id                      String    @id @default(cuid())
  clerkOrgId              String    @map("clerk_org_id")
  vehicleId               Int       @map("vehicle_id") // Motive vehicle ID
  vehicleNumber           String?   @map("vehicle_number")
  vin                     String?
  date                    String    // YYYY-MM-DD
  
  // Utilization metrics
  lastLocatedAt           String?   @map("last_located_at") // ISO 8601 timestamp
  utilizationPercentage   Float?    @map("utilization_percentage")
  idleTime                Int?      @map("idle_time") // minutes (normalized from API seconds)
  idleFuel                Float?    @map("idle_fuel") // gallons
  drivingTime             Int?      @map("driving_time") // minutes (normalized from API seconds)
  drivingFuel             Float?    @map("driving_fuel") // gallons
  totalFuel               Float?    @map("total_fuel") // gallons
  totalDistance           Float?    @map("total_distance") // miles
  message                 String?   // API messages/errors
  
  // Data verification tracking
  lastVerifiedAt          DateTime? @map("last_verified_at")
  dataVersion             Int       @default(1) @map("data_version")
  
  // Full API response for reference
  rawResponse             Json      @map("raw_response")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@unique([clerkOrgId, vehicleId, date])
  @@index([clerkOrgId])
  @@index([vehicleId])
  @@index([vin])
  @@index([date])
  @@index([clerkOrgId, date])
  @@index([lastVerifiedAt])
  @@map("motive_vehicle_utilization")
}

// MOTIVE Geofences (location boundaries/zones)
// Source: GET /v1/geofences
// Stores geofence definitions with polygons
// NOTE: This is configuration data, not transactional - synced periodically
model MotiveGeofence {
  id                String    @id @default(cuid())
  clerkOrgId        String    @map("clerk_org_id")
  motiveGeofenceId  Int       @map("motive_geofence_id") // Motive's geofence ID
  
  // Geofence metadata
  name              String
  status            String    // "active", "deactivated"
  address           String?
  description       String?
  category          String?   // "Uncategorized", "Fuel Station", "Customer", etc.
  
  // Location polygon (array of lat/lon points)
  locationPoints    Json      @map("location_points") // [{lat, lon}, {lat, lon}, ...]
  
  // Full API response for reference
  rawResponse       Json      @map("raw_response")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([clerkOrgId, motiveGeofenceId])
  @@index([clerkOrgId])
  @@index([motiveGeofenceId])
  @@index([status])
  @@index([category])
  @@map("motive_geofences")
}

// Enums for telematics
enum TelematicsProvider {
  SAMSARA
  MOTIVE
}

enum TelematicsProviderStatus {
  ACTIVE
  ERROR
  DISABLED
}

// Service Plan Units: Links repair units to telematics and manages inclusion
// This is the source of truth for which units should appear in the fleet view
model ServicePlanUnit {
  id                String    @id @default(cuid())
  clerkOrgId        String    @map("clerk_org_id")
  
  // Repair database identifiers (source of truth)
  repairUnitId      String    @map("repair_unit_id")      // customer_units.unit_id
  repairUnitNumber  String?   @map("repair_unit_number")  // customer_units.number
  repairVin         String?   @map("repair_vin")          // VIN from repair DB
  repairCustomerId  String?   @map("repair_customer_id")  // customer_units.cust_id
  
  // Telematics matching
  telematicsVin       String?   @map("telematics_vin")        // Matched telematics VIN
  telematicsVehicleId String?   @map("telematics_vehicle_id") // Fallback ID for VIN-less telematics vehicles
  matchType           ServicePlanMatchType @default(UNMATCHED) @map("match_type")
  matchConfidence     Float?    @map("match_confidence")      // 0.0 to 1.0 for auto-matches

  // True when unit came from telematics only (no repair DB record)
  // repairUnitId is a stable cuid in this case, NOT a repair DB ID
  isTelematicsOnly  Boolean   @default(false) @map("is_telematics_only")

  // Service plan configuration
  isIncluded        Boolean   @default(true) @map("is_included")      // Whether this unit appears in the external portal
  isConfirmed       Boolean   @default(false) @map("is_confirmed")    // Acknowledged as intentionally having no telematics
  customUnitName    String?   @map("custom_unit_name")                // Admin-set display name override
  notes             String?
  
  // Audit trail
  matchedBy         String?   @map("matched_by")          // Clerk user ID who manually matched
  matchedAt         DateTime? @map("matched_at")
  lastSyncedAt      DateTime? @map("last_synced_at")      // Last sync from repair DB
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  @@unique([clerkOrgId, repairUnitId])
  @@index([clerkOrgId])
  @@index([matchType])
  @@index([repairVin])
  @@index([telematicsVin])
  @@map("service_plan_units")
}

enum ServicePlanMatchType {
  AUTO          // Automatically matched via VIN
  MANUAL        // Manually matched by admin
  UNMATCHED     // No telematics match
}

// SAMSARA Vehicle Utilization (normalized, per day per vehicle)
// Write target for syncFuelEnergyReports. All units converted at write time.
model SamsaraVehicleUtilization {
  id              String   @id @default(cuid())
  clerkOrgId      String   @map("clerk_org_id")
  vehicleId       String   @map("vehicle_id")
  vehicleName     String?  @map("vehicle_name")
  vin             String?

  date            String   // YYYY-MM-DD (EST calendar day)

  // All values in display units — converted from raw API units at write time
  fuelGallons     Float?   @map("fuel_gallons")       // mL → gal (÷3785.41)
  distanceMiles   Float?   @map("distance_miles")     // meters → miles (÷1609.34)
  engineOnMinutes Float?   @map("engine_on_minutes")  // ms → min (÷60000)
  drivingMinutes  Float?   @map("driving_minutes")    // (engineOn - idle) ms → min
  idleMinutes     Float?   @map("idle_minutes")       // ms → min
  idleFuelGallons Float?   @map("idle_fuel_gallons")  // sum from samsara_idling_events (mL → gal)
  mpg             Float?                               // distanceMiles / fuelGallons

  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([clerkOrgId, vehicleId, date])
  @@index([clerkOrgId])
  @@index([vehicleId])
  @@index([date])
  @@index([clerkOrgId, date])
  @@map("samsara_vehicle_utilization")
}

// SAMSARA Vehicle Stats Snapshot (OBD + GPS point-in-time)
// Source: GET /fleet/vehicles/stats
model SamsaraVehicleStatsSnapshot {
  id                String   @id @default(cuid())
  clerkOrgId        String   @map("clerk_org_id")
  vehicleId         String   @map("vehicle_id")
  vehicleName       String?  @map("vehicle_name")
  capturedAt        DateTime @map("captured_at")  // timestamp from API

  obdOdometerMeters  Float?  @map("obd_odometer_meters")
  obdEngineSeconds   Float?  @map("obd_engine_seconds")
  gpsOdometerMeters  Float?  @map("gps_odometer_meters")

  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([clerkOrgId, vehicleId, capturedAt])
  @@index([clerkOrgId])
  @@index([vehicleId])
  @@index([capturedAt])
  @@map("samsara_vehicle_stats_snapshots")
}

// SAMSARA Safety Events (one row per event)
// Source: GET /fleet/safety-events
model SamsaraSafetyEvent {
  id            String   @id @default(cuid())
  clerkOrgId    String   @map("clerk_org_id")
  samsaraId     String   @map("samsara_id")     // Samsara's event ID

  vehicleId     String   @map("vehicle_id")
  vehicleName   String?  @map("vehicle_name")
  driverId      String?  @map("driver_id")
  driverName    String?  @map("driver_name")

  behaviorLabel String   @map("behavior_label") // e.g. "harshAccel", "harshBrake"
  severity      String?                          // "low", "medium", "high"
  maxValue      Float?   @map("max_value")
  time          String                           // ISO 8601
  eventDate     String   @map("event_date")      // YYYY-MM-DD for range queries

  lat           Float?
  lon           Float?

  rawResponse   Json?    @map("raw_response")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([clerkOrgId, samsaraId])
  @@index([clerkOrgId])
  @@index([vehicleId])
  @@index([eventDate])
  @@index([clerkOrgId, eventDate])
  @@map("samsara_safety_events")
}

// MOTIVE Scorecard Summaries (per driver per period)
// Source: GET /v1/scorecard_summary
// Returns driver performance rollups: hard events, score, km driven
model MotiveScorecardSummary {
  id                  String   @id @default(cuid())
  clerkOrgId          String   @map("clerk_org_id")
  driverId            Int?     @map("driver_id")
  driverFirstName     String?  @map("driver_first_name")
  driverLastName      String?  @map("driver_last_name")
  driverUsername      String?  @map("driver_username")
  driverEmail         String?  @map("driver_email")
  date                String   // YYYY-MM-DD (period date)

  score               Float?
  numCoachedEvents    Int?     @map("num_coached_events")
  numHardAccels       Int?     @map("num_hard_accels")
  numHardBrakes       Int?     @map("num_hard_brakes")
  numHardCorners      Int?     @map("num_hard_corners")
  totalKilometers     Float?   @map("total_kilometers")

  rawResponse         Json     @map("raw_response")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([clerkOrgId, driverId, date])
  @@index([clerkOrgId])
  @@index([driverId])
  @@index([date])
  @@map("motive_scorecard_summaries")
}

// System Config (key-value store for app-wide settings)
// Used for: diesel_price_per_gallon (EIA weekly fetch), feature flags, etc.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// SAMSARA Driver Fuel & Energy Reports (per driver per day)
// Source: GET /v1/fleet/reports/fuel-energy/drivers
// Tracks per-driver fuel consumption, distance, and idle metrics
model SamsaraDriverFuelEnergy {
  id                    String   @id @default(cuid())
  clerkOrgId            String   @map("clerk_org_id")

  // Driver identifiers
  driverId              String   @map("driver_id")       // Samsara driver ID
  driverName            String?  @map("driver_name")
  driverExternalId      String?  @map("driver_external_id")

  // Date
  date                  String   // YYYY-MM-DD

  // Distance
  totalDistanceMiles    Float?   @map("total_distance_miles")

  // Fuel
  totalFuelUsedGallons  Float?   @map("total_fuel_used_gallons")
  engineIdleFuelGallons Float?   @map("engine_idle_fuel_gallons")

  // Time
  engineRunTimeMs       BigInt?  @map("engine_run_time_ms")
  engineIdleTimeMs      BigInt?  @map("engine_idle_time_ms")

  rawResponse           Json?    @map("raw_response")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([clerkOrgId, driverId, date])
  @@index([clerkOrgId])
  @@index([clerkOrgId, date])
  @@map("samsara_driver_fuel_energy")
}

// SAMSARA Driver Efficiency Reports (per driver per day)
// Source: GET /v1/fleet/efficiency/drivers
// Tracks safety scores, harsh events, and driving efficiency per driver
model SamsaraDriverEfficiency {
  id                    String   @id @default(cuid())
  clerkOrgId            String   @map("clerk_org_id")

  // Driver identifiers
  driverId              String   @map("driver_id")
  driverName            String?  @map("driver_name")
  driverExternalId      String?  @map("driver_external_id")

  // Date
  date                  String   // YYYY-MM-DD

  // Safety / Efficiency scores
  overallSafetyScore    Float?   @map("overall_safety_score")
  speedingScore         Float?   @map("speeding_score")
  harshBrakingScore     Float?   @map("harsh_braking_score")
  harshAccelScore       Float?   @map("harsh_accel_score")

  // Event counts
  harshBrakingCount     Int?     @map("harsh_braking_count")
  harshAccelCount       Int?     @map("harsh_accel_count")
  harshTurnCount        Int?     @map("harsh_turn_count")
  speedingCount         Int?     @map("speeding_count")

  // Distance driven (miles)
  totalDistanceMiles    Float?   @map("total_distance_miles")

  rawResponse           Json?    @map("raw_response")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([clerkOrgId, driverId, date])
  @@index([clerkOrgId])
  @@index([clerkOrgId, date])
  @@map("samsara_driver_efficiency")
}
