# Server
PORT=4000
NODE_ENV=development

# Repair Database (READ-ONLY - external repair/invoice data)
# CRITICAL: Must include default_transaction_read_only=on for safety
# Format: postgresql://user:password@host:port/database?sslmode=require&schema=public&options=-c%20default_transaction_read_only=on
# 
# The API will REFUSE to start if this URL does not meet safety requirements:
#   ✓ sslmode=require
#   ✓ schema=public
#   ✓ options=-c default_transaction_read_only=on (URL-encoded: %20 for spaces)
REPAIR_DATABASE_URL="postgresql://fleet_saas_db_user:PUT_PASSWORD_HERE@dpg-d2mbnhidbo4c73d4shrg-a.ohio-postgres.render.com:5432/fleet_saas_db?sslmode=require&schema=public&options=-c%20default_transaction_read_only=on"

# App Database (READ-WRITE - portal-owned data)
# This stores org mappings, telematics credentials, etc.
# Run: pnpm prisma:app:migrate to set up this database
APP_DATABASE_URL="postgresql://user:password@localhost:5432/kerry_leasing_app?schema=public"

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# CORS - comma-separated list of allowed origins (must match the browser’s Origin, e.g. Vercel URL or local dev)
# Production: https://www.kerryleasing.com,https://kerryleasing.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007

# Redis Cache (optional — falls back to direct DB if not set)
# Provision via Upstash, Redis Cloud, or Railway. Use rediss:// (TLS) in production.
# REDIS_URL=redis://localhost:6379

# Safety Override (LOCAL TESTING ONLY - DO NOT USE IN PRODUCTION)
# Bypasses repair database safety checks
# DANGER: Only set this to 'true' for local development/testing
# NEVER set this in production or you risk data corruption
# ALLOW_UNSAFE_REPAIR_DB=false

# Weekly driver report EMAIL (sent via Microsoft Graph from a real mailbox).
# Reuses the MICROSOFT_GRAPH_* app credentials used by the daily-service workbook.
# The Graph app registration must be granted the Mail.Send APPLICATION permission,
# and this mailbox must exist in the tenant. Until REPORT_EMAIL_FROM is set the
# email channel stays in dry-run (writes send rows, sends nothing).
# REPORT_EMAIL_FROM=reports@kerrybros.com
# EMAIL_DRY_RUN=false   # force dry-run even when a from-address is set

